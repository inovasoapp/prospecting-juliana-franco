---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const stats = [
  { value: 13, suffix: "+", label: "Anos de atuação" },
  { value: 100, suffix: "+", label: "Projetos entregues" },
  { value: 40, suffix: "+", label: "Clientes atendidos" },
  { value: 100, suffix: "%", label: "Satisfação dos clientes" },
];
---

<div
  id="destaque-mobile"
  class:list={[
    "w-full rounded-2xl bg-brown/15 backdrop-blur-md border border-white/20 px-3 py-4 shadow-sm",
    className,
  ]}
>
  <div class="grid grid-cols-4 items-center divide-x divide-background/20">
    {
      stats.map((stat) => (
        <div class="flex flex-col items-center justify-center text-center px-1">
          <span
            class="stat-number-mobile font-serif text-xl sm:text-2xl font-bold text-neutral-700 leading-tight"
            data-value={stat.value}
            data-suffix={stat.suffix}
          >
            {`0${stat.suffix}`}
          </span>
          <span class="mt-1 text-[8.5px] sm:text-[10px] leading-tight uppercase tracking-wider text-neutral-600 font-medium text-center">
            {stat.label}
          </span>
        </div>
      ))
    }
  </div>
</div>

<script>
  import { animate, inView } from "motion";

  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  const numbers = document.querySelectorAll<HTMLElement>(
    "#destaque-mobile .stat-number-mobile",
  );

  numbers.forEach((el) => {
    const target = Number(el.dataset.value ?? "0");
    const suffix = el.dataset.suffix ?? "";

    if (prefersReducedMotion) {
      el.textContent = `${target}${suffix}`;
      return;
    }

    inView(
      el,
      () => {
        animate<number>(0, target, {
          duration: 1.4,
          ease: "easeOut",
          onUpdate: (latest: number) => {
            el.textContent = `${Math.round(latest)}${suffix}`;
          },
        });
      },
      { amount: 0.3 },
    );
  });
</script>
