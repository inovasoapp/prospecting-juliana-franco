---
import CommonSectionWrapper from "./CommonSectionWrapper.astro";
import ProjectGallery from "./ProjectGallery.tsx";

const projects = [
  {
    number: "01",
    category: "Arquitetura · Interiores",
    title: "Residência Jardins",
    description:
      "Um projeto pensado para equilibrar acolhimento, funcionalidade e uma estética atemporal, respeitando a personalidade de quem vive o espaço.",
    images: [
      {
        src: "/images/projetos/projeto1-b.webp",
        alt: "Residência Jardins — vista principal",
      },
      {
        src: "/images/projetos/projeto1-a.webp",
        alt: "Residência Jardins — interiores",
      },
      {
        src: "/images/projetos/projeto1-c.webp",
        alt: "Residência Jardins — sala",
      },
      {
        src: "/images/projetos/projeto1-d.webp",
        alt: "Residência Jardins — jantar",
      },
      {
        src: "/images/projetos/projeto1-e.webp",
        alt: "Residência Jardins — detalhes",
      },
      
    ],
  },

  {
    number: "02",
    category: "Arquitetura · Interiores",
    title: "Apartamento Higienópolis",
    description:
      "Uma intervenção cuidadosa que valoriza a luz natural, os materiais e a relação entre os ambientes.",
    images: [
      {
        src: "/images/projetos/projeto2-a.webp",
        alt: "Apartamento Higienópolis — vista principal",
      },
      {
        src: "/images/projetos/projeto2-b.webp",
        alt: "Apartamento Higienópolis — interiores",
      },
      {
        src: "/images/projetos/projeto2-c.webp",
        alt: "Apartamento Higienópolis — sala",
      },
      {
        src: "/images/projetos/projeto2-d.webp",
        alt: "Apartamento Higienópolis — detalhes",
      },
      {
        src: "/images/projetos/projeto2-e.webp",
        alt: "Apartamento Higienópolis — cozinha",
      },
    ],
  },

  {
    number: "03",
    category: "Arquitetura · Interiores",
    title: "Apartamento Alphaville",
    description:
      "Arquitetura, interiores e paisagismo conectados em uma composição contemporânea, elegante e essencial.",
    images: [
      {
        src: "/images/projetos/projeto3-a.webp",
        alt: "Apartamento Alphaville — vista principal",
      },
      {
        src: "/images/projetos/projeto3-b.webp",
        alt: "Apartamento Alphaville — interiores",
      },
      {
        src: "/images/projetos/projeto3-c.webp",
        alt: "Apartamento Alphaville — sala",
      },
      {
        src: "/images/projetos/projeto3-d.webp",
        alt: "Apartamento Alphaville — cozinha",
      },
      {
        src: "/images/projetos/projeto3-e.webp",
        alt: "Apartamento Alphaville — detalhes",
      },
      
    ],
  },
  {
    number: "04",
    category: "Arquitetura · Interiores",
    title: "Apartamento Moema",
    description:
      "Um projeto que traduz a personalidade dos moradores em cada detalhe.",
    images: [
      {
        src: "/images/projetos/projeto4-a.webp",
        alt: "Casa Moema — vista principal",
      },
      {
        src: "/images/projetos/projeto4-b.webp",
        alt: "Casa Moema — interiores",
      },
      {
        src: "/images/projetos/projeto4-c.webp",
        alt: "Casa Moema — sala",
      },
      {
        src: "/images/projetos/projeto4-d.webp",
        alt: "Casa Moema — cozinha",
      },
      {
        src: "/images/projetos/projeto4-e.webp",
        alt: "Casa Moema — detalhes",
      },
    ],
  },
  {
    number: "05",
    category: "Arquitetura · Interiores",
    title: "Apartamento Jardins",
    description:
      "Um projeto que traduz a personalidade dos moradores em cada detalhe.",
    images: [
      {
        src: "/images/projetos/projeto5-a.webp",
        alt: "Apartamento Jardins — vista principal",
      },
      {
        src: "/images/projetos/projeto5-b.webp",
        alt: "Apartamento Jardins — interiores",
      },
      {
        src: "/images/projetos/projeto5-c.webp",
        alt: "Apartamento Jardins — sala",
      },
      {
        src: "/images/projetos/projeto5-d.webp",
        alt: "Apartamento Jardins — cozinha",
      },
      {
        src: "/images/projetos/projeto5-e.webp",
        alt: "Apartamento Jardins — detalhes",
      },
    ],
